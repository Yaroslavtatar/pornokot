/* Shared HUD alignment: center the brand and give every action identical icon/text rows. */
.brand {
    align-items: center
}

.brand-icon {
    line-height: 1;
    flex-shrink: 0
}

.brand>div {
    min-width: 0
}

.brand h1 {
    line-height: 1.25
}

.actions {
    --action-icon-size: 24px;
    --action-label-line: 12px;
    --action-row-gap: 2px
}

.actions button {
    display: grid;
    grid-template-rows: var(--action-icon-size) var(--action-label-line);
    align-content: center;
    justify-items: center;
    gap: var(--action-row-gap);
    padding: 4px 2px;
    line-height: 1
}

.actions .action-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--action-icon-size);
    height: var(--action-icon-size);
    line-height: 1;
    font-size: 23px
}

.actions small {
    margin: 0;
    font-size: 10px;
    line-height: var(--action-label-line);
    white-space: nowrap
}

@media(max-width: 700px) {
    .actions button {
        width:46px;
        height: 48px
    }

    .actions .action-icon {
        font-size: 22px
    }

    .actions small {
        font-size: 9px
    }
}

/* Input capability, not phone width, decides whether a movement pad is useful. */
#joystick {
    display: none
}

@media(any-pointer: coarse) {
    #joystick {
        display:flex;
        position: fixed;
        left: max(23px,env(safe-area-inset-left));
        bottom: 210px;
        width: 102px;
        height: 102px;
        border: 2px solid #fffaf0ac;
        border-radius: 50%;
        background: #f8f6df46;
        box-shadow: 0 2px 10px #344b3520;
        align-items: center;
        justify-content: center;
        touch-action: none
    }

    #stick {
        width: 46px;
        height: 46px;
        border: 2px solid #fff9ded4;
        border-radius: 50%;
        background: #fff9e3b5;
        color: #466248;
        display: grid;
        place-items: center;
        font-size: 24px;
        pointer-events: none
    }
}

@media(any-pointer: coarse) and (max-width:700px) {
    #joystick {
        bottom:178px
    }
}

